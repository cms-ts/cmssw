//==============================================================================
//   Z+Jet Analysis Framework - README
//==============================================================================

//--------------------------------
// 1. Basic Analysis (Interactive)
//--------------------------------
// Run the main analyzer macro directly.
// Arguments: (collision_type, sample_name, weight_phase, systFlag)
//
// weight_phase: 1=Data(default), 3=Final MC Analysis
// systFlag: 0=Nominal

// --- PbPb 2023 ---
root -l -b -q 'analyze_HI_TTreeReader_ZMM.C("PbPb23", "data", 1, 0)'    // Data
root -l -b -q 'analyze_HI_TTreeReader_ZMM.C("PbPb23", "signal", 3, 0)'  // MC Signal (Final)

// --- pp Ref 2024 ---
root -l -b -q 'analyze_HI_TTreeReader_ZMM.C("ppref24", "data", 1, 0)'   // Data
root -l -b -q 'analyze_HI_TTreeReader_ZMM.C("ppref24", "signal", 3, 0)' // MC Signal

// --- PbPb 2024 ---
root -l -b -q 'analyze_HI_TTreeReader_ZMM.C("PbPb24", "data", 1, 0)'    // Data
root -l -b -q 'analyze_HI_TTreeReader_ZMM.C("PbPb24", "signal", 3, 0)' // MC Signal

// IMPORTANT: Open the following wrappers and uncomment the desired COLLISION type at the top.


//--------------------------------
// 2. Workflow Weights calculation
//--------------------------------

// Before, to recompute MC_all_weights, go to folder
cd weights_MC/MC_all_weights/
// and follow the README

// Runs Data and MC Signal to compute Ncoll, Rho, and Vz weights,
// then produces final histograms.
chmod +x do_analyze_weights.sh
./do_analyze_weights.sh
// Outputs saved in: weights_MC/ and plot/


//--------------------------------
// 3. Background MC Analysis
//--------------------------------
// Runs the analyzer over background samples (TT, WZ, ZZ, etc.) defined in the script.

chmod +x do_analyze_bkg.sh
./do_analyze_bkg.sh
// Outputs saved in: plot/


//--------------------------------
// 4. Systematics Analysis
//--------------------------------
// Runs loops over Data and MC for various systematic variations 
// (JEC, JER, SF, Centrality, etc.).

chmod +x do_analyze_syst.sh
./do_analyze_syst.sh
// Outputs saved in: plot/, syst_JEC/, syst_JER/, syst_SF_muon/, etc.


// --- Deprecated ---
//--------------------------------
//To run over data and all MC in MC_samples.h
chmod +x old_do_analyze_stack.sh
./old_do_analyze_stack.sh
//the output root files are saved in stack/ folder
//--------------------------------

