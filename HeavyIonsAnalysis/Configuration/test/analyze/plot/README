//--------------------------------
//  Plot iso check
//--------------------------------
// Macro: plot_iso_check.C
// Arguments: (collision_type, cent_min, cent_max, ptZ_min, ptZ_max)

// 1. PbPb23 (Defaults: 0-30%, pT > 40)
root -l -b -q plot_iso_check.C

// 2. ppref24
root -l -b -q 'plot_iso_check.C("ppref24")'

// 3. Use "PbPb24" for PbPb24
root -l -b -q 'plot_iso_check.C("PbPb24")'

// 4. Example for PbPb23 with different kinematics (30-50%, pT > 60)
root -l -b -q 'plot_iso_check.C("PbPb23", 30, 50, 60, 9999)'


//--------------------------------
//  Plot veto check
//--------------------------------
// Macro: plot_veto_check.C
// Arguments: (collision_type, isData, cent_min, cent_max, ptZ_min, ptZ_max)

// 1. PbPb23 (Defaults: 0-30%, pT > 40)
root -l -b -q plot_veto_check.C                    // Data (Default)
root -l -b -q 'plot_veto_check.C("PbPb23", false)'  // MC Signal

// 2. ppref24
root -l -b -q 'plot_veto_check.C("ppref24", true)'  // Data
root -l -b -q 'plot_veto_check.C("ppref24", false)' // MC Signal

// 3. Use "PbPb24" for PbPb24
root -l -b -q 'plot_veto_check.C("PbPb24", true)'   // Data
root -l -b -q 'plot_veto_check.C("PbPb24", false)' // MC Signal

// 4. Example for PbPb23 MC Signal with different kinematics (30-50%, pT > 60)
root -l -b -q 'plot_veto_check.C("PbPb23", false, 30, 50, 60, 9999)'

// 5. Specific Background MC (e.g., TT, WZ, etc.)
// You can specify MC sample label modifying inside plot_veto_check.C

//--------------------------------
//  Plot SF
//--------------------------------
// Macro: plot_sf_2d.C
// Arguments: (collision_type, Lumi)
// 1. PbPb23 (Default)
root -l -b -q plot_sf_2d.C

// 2. ppref24
root -l -b -q 'plot_sf_2d.C("ppref24")'

//--------------------------------
//  Plot JES_JER_Performance
//--------------------------------
// Macro: plot_JES_JER.C
// Arguments: (test_pt, test_rho)
// Default test_pt = 40, test_rho = 80 for Pb 23
root -l -b -q plot_JES_JER.C
// test_pt = 50, test_rho = 50
root -l -b -q 'plot_JES_JER.C(50.0, 50.0)'

//--------------------------------
//  Extract acceptance
//--------------------------------
// Macro: extract_acceptance.C
// Arguments: (input_file)
// Default input_file = "output_HI_mu_MC_signal_Cen0_30_ptZ40_Inf.root"
root -l -b -q extract_acceptance.C

// --- Deprecated ---
//--------------------------------
//  Plot data and MC signal plots
//--------------------------------
//To plot one histo, for ex. h_mumu_j
root -l -b -q 'old_plot.C("h_mumu_j")'
//To plot all histo
chmod +x old_do_plot_all.sh
./do_plot_all.sh
