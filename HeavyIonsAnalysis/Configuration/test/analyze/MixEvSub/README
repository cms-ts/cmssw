//--------------------------------
  Produce ntuples for MinBias events
  in order to perform Mixed Event
  Background Subtraction
//--------------------------------

//--------------------------------
//To run analyzer on data
root -l -b -q analyze_MinBias_TTreeReader.C
//the output is MinBias_leading_jets_data_HF.root
//Default isData, for MC
root -l -b -q 'analyze_MinBias_TTreeReader.C(false)'
//the output is MinBias_leading_jets_MC_HF.root

//To use vz binning instead of HF
root -l -b -q 'analyze_MinBias_TTreeReader.C(true,1)'
//the output is MinBias_leading_jets_data_VZ.root'
root -l -b -q 'analyze_MinBias_TTreeReader.C(false,1)'
//the output is MinBias_leading_jets_MC_VZ.root
//--------------------------------

//To use VZ + Centrality binning 
root -l -b -q 'analyze_MinBias_TTreeReader.C(true,2)'
//the output is MinBias_leading_jets_data_VZ_Cen_Combined.root'
root -l -b -q 'analyze_MinBias_TTreeReader.C(false,2)'
//the output is MinBias_leading_jets_MC_VZ_Cen_Combined.root
//--------------------------------

//--------------------------------
  Plot Mixed Event Bkg subtraction plots
//--------------------------------

//To plot one histo, for ex. h_xZj 
root -l -b -q 'plot_MinBias.C("h_xZj", true)'
//Default isData, for MC
root -l -b -q 'plot_MinBias.C("h_xZj", false)'
//To plot all histograms
chmod +x do_plot_MinBias.sh
./do_plot_MinBias.sh
